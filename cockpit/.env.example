# Cockpit · env (Vite only reads VITE_* at build time)

# Production / custom relay WebSocket (optional in local dev — proxy used instead)
# VITE_BUZZ_RELAY_WS=wss://your-relay.example.com

# NIP-42 auth URL if it differs from the browser WS URL
# (required when using the Vite /relay-ws proxy — defaults handle local)
# VITE_BUZZ_RELAY_AUTH_URL=ws://127.0.0.1:3000

# Dev proxy target for /relay-ws and /relay-http
# BUZZ_RELAY_HTTP=http://127.0.0.1:3000

# Port for `pnpm dev` (portless also sets PORT)
# PORT=5174
# VITE_PORT=5174
